
APP_NAME="Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_DEMO=false

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=''

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
DEFAULT_LANGUAGE=en

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=


# Add this key who purchase the Website Addon
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Checkout de programas individuales / paquetes (ver docs/ en el repo bsa,
# PLAN_VENTAS_PROGRAMAS_Y_BLOG.md) -- URL de la web a la que se redirige tras
# el pago (éxito/cancelación).
FRONTEND_URL=https://bestronger.es

# Stripe -- checkout con tarjeta, Bizum y Link en una sola Checkout Session.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal -- alternativa en el mismo checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Rechazo de Apple Guideline 1.4.1 (afirmaciones de salud sin cita en las
# descripciones de Recetas/Dietas). Mientras se revisa/reescribe ese texto
# (ver database/scripts/find_medical_claims.php), en true oculta el campo
# "description" en las respuestas publicas de la API (panel de admin no
# afectado). Poner en false en cuanto Apple apruebe la app.
HIDE_RECIPE_DIET_DESCRIPTIONS=true